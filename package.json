{
  "name": "onetricks-client",
  "version": "1.0.4",
  "description": "Onetricks.gg LoL Desktop Client",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "selfsigned": "^5.5.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.onetricks.client",
    "productName": "Onetricks Client",
    "publish": {
      "provider": "github",
      "owner": "Triboott",
      "repo": "onetricks-client"
    },
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "app_icon.png"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    }
  }
}
